# Apple ID (iCloud 帳號 email)
ICLOUD_USERNAME=xxx

# App 專用密碼：https://appleid.apple.com → 登入與安全性 → App 專用密碼
# 注意：不是 Apple ID 主密碼
ICLOUD_APP_PASSWORD=xxx

# Discord 頻道 Webhook URL
# 頻道 → 編輯頻道 → 整合 → Webhook → 新增 → 複製 URL
DISCORD_WEBHOOK_URL=xxx

# 時區（預設 Asia/Taipei）
TZ=Asia/Taipei

# 每日通知時間（24 小時制）
NOTIFY_HOUR=8
NOTIFY_MINUTE=0

# 啟動容器時立即跑一次（測試用），設為 1 啟用
RUN_ON_START=1
